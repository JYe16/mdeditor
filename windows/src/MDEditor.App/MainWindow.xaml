<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MDEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
  <Grid x:Name="Root" AllowDrop="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="32"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto" MinHeight="22"/>
    </Grid.RowDefinitions>

    <Grid x:Name="TitleArea" Grid.Row="0" Padding="12,0,140,0" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Image x:Name="TitleIcon" Width="16" Height="16" VerticalAlignment="Center"/>
      <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 Style="{StaticResource CaptionTextBlockStyle}"/>
    </Grid>

    <Grid Grid.Row="1" Padding="4,0,4,4">
      <MenuBar x:Name="Menu" HorizontalAlignment="Left"/>
      <StackPanel x:Name="ModeButtons" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
        <ToggleButton x:Name="ModeEditor" Padding="10,4" Click="OnModeClick" Tag="editor">
          <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
        </ToggleButton>
        <ToggleButton x:Name="ModeSplit" Padding="10,4" Click="OnModeClick" Tag="split">
          <FontIcon Glyph="&#xE89F;" FontSize="14"/>
        </ToggleButton>
        <ToggleButton x:Name="ModePreview" Padding="10,4" Click="OnModeClick" Tag="preview">
          <FontIcon Glyph="&#xE8A1;" FontSize="14"/>
        </ToggleButton>
      </StackPanel>
    </Grid>

    <Grid x:Name="Panes" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="240"/>
        <ColumnDefinition x:Name="SplitterColumn" Width="Auto"/>
        <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="240"/>
      </Grid.ColumnDefinitions>

      <Grid x:Name="EditorPane" Grid.Column="0">
        <Grid x:Name="FindBar" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Right" Canvas.ZIndex="1"
              Margin="0,6,18,0" Padding="8" RowSpacing="6" ColumnSpacing="4" CornerRadius="6" BorderThickness="1"
              Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
              BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="ReplaceRow" Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto" MinWidth="64"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="FindBox" TextChanged="OnFindTextChanged" KeyDown="OnFindKeyDown"/>
          <ToggleButton x:Name="MatchCaseButton" Grid.Column="1" Content="Aa" Padding="8,4" Click="OnFindOptionClick"/>
          <ToggleButton x:Name="WholeWordButton" Grid.Column="2" Content="ab|" Padding="8,4" Click="OnFindOptionClick"/>
          <TextBlock x:Name="FindCount" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0"
                     Style="{StaticResource CaptionTextBlockStyle}"/>
          <Button x:Name="FindPrevButton" Grid.Column="4" Padding="8,6" Click="OnFindPrevClick"><FontIcon Glyph="&#xE70E;" FontSize="12"/></Button>
          <Button x:Name="FindNextButton" Grid.Column="5" Padding="8,6" Click="OnFindNextClick"><FontIcon Glyph="&#xE70D;" FontSize="12"/></Button>
          <Button x:Name="FindCloseButton" Grid.Column="6" Padding="8,6" Click="OnFindCloseClick"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>

          <TextBox x:Name="ReplaceBox" Grid.Row="1" KeyDown="OnReplaceKeyDown"/>
          <StackPanel x:Name="ReplaceButtons" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="6" Orientation="Horizontal" Spacing="4">
            <Button x:Name="ReplaceOneButton" Click="OnReplaceClick"/>
            <Button x:Name="ReplaceAllButton" Click="OnReplaceAllClick"/>
          </StackPanel>
        </Grid>
      </Grid>

      <Grid x:Name="SplitterHost" Grid.Column="1"/>

      <Grid x:Name="PreviewPane" Grid.Column="2">
        <controls:WebView2 x:Name="Web"/>
        <StackPanel x:Name="WebViewMissing" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="360">
          <TextBlock x:Name="WebViewMissingTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
          <TextBlock x:Name="WebViewMissingBody" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
          <HyperlinkButton x:Name="WebViewMissingLink" HorizontalAlignment="Center" NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/"/>
        </StackPanel>
      </Grid>
    </Grid>

    <StackPanel x:Name="StatusBar" Grid.Row="3" Orientation="Horizontal" Spacing="16" Padding="12,2">
      <TextBlock x:Name="WordsText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
      <TextBlock x:Name="CharsText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
      <TextBlock x:Name="MinutesText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
    </StackPanel>
  </Grid>
</Window>
