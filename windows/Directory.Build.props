<Project>
  <!-- Single source of truth for the version: the assemblies, the About box and the installer all read it. -->
  <PropertyGroup>
    <Version>1.1.0</Version>
    <Product>MDEditor</Product>
    <Company>JYe16</Company>
    <Authors>JYe16</Authors>
    <Copyright>Copyright (c) 2026 JYe16</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
